PORT=5000
FRONTEND_URL=http://localhost:3000

# ข้อมูลจาก Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

JWT_SECRET=
ENCRYPTION_SECRET=

# URL เชื่อมต่อ Database อ้างอิงจาก docker-compose
DATABASE_URL="postgresql://mailmind_user:mailmind_password@localhost:5432/mailmind_db?schema=public"

# Local AI (Ollama) Settings
LOCAL_AI_BASE_URL="http://localhost:11434/v1"
LOCAL_AI_MODEL="llama3.1:8b"

# Console observability
# Use LOG_LEVEL=debug together with LOG_SENSITIVE_CONTENT=true only for short-lived local debugging.
LOG_LEVEL=info
LOG_SENSITIVE_CONTENT=false
